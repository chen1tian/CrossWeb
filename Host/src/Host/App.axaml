<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Host"
             xmlns:fluent="using:Avalonia.Themes.Fluent"
             xmlns:themes="clr-namespace:Material.Styles.Themes;assembly=Material.Styles"
             xmlns:dialogHostAvalonia="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             x:Class="Host.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <dialogHostAvalonia:DialogHostStyles />
		<!-- Fluent supplies the Avalonia 12 Page control templates. Material is
		     loaded afterwards so it remains the application theme. -->
		<fluent:FluentTheme />
		<themes:MaterialTheme BaseTheme="Light" PrimaryColor="Blue" SecondaryColor="Lime" />
		<Style Selector=":is(TemplatedControl)">
			<Setter Property="FontFamily" Value="avares://Host/Resources/Fonts#Source Han Sans SC" />
		</Style>
	</Application.Styles>
</Application>
