<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CrossWebHost.ViewModels"
			 xmlns:dialogHostAvalonia="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CrossWebHost.Views.MainView"
             x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
         to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <vm:MainViewModel />
  </Design.DataContext>

  <dialogHostAvalonia:DialogHost Identifier="MainDialogHost" DisableOpeningAnimation="True">
    <DrawerPage IsOpen="{Binding NavDrawerSwitch, Mode=TwoWay}"
                DrawerLayoutBehavior="CompactInline"
                DrawerLength="150"
                CompactDrawerLength="56"
                DrawerBackground="{DynamicResource MaterialBackgroundBrush}"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch">
      <DrawerPage.Drawer>
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Top" Padding="16,18,16,12">
            <TextBlock Text="CrossWebHost"
                       Classes="Headline6"
                       IsVisible="{Binding IsMenuTextVisible}"
                       VerticalAlignment="Center" />
          </Border>

          <Border DockPanel.Dock="Bottom"
                  Height="1"
                  Background="{DynamicResource MaterialDividerBrush}" />

          <ScrollViewer>
            <ListBox ItemsSource="{Binding MenuItems}"
                     SelectedItem="{Binding SelectedMenuItem, Mode=TwoWay}"
                     SelectionChanged="OnMenuSelectionChanged"
                     Background="Transparent"
                     Margin="4,8">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:NavMenuItem">
                  <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4">
                    <PathIcon x:CompileBindings="False"
                              Data="{Binding Icon}"
                              Width="22"
                              Height="22"
                              VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title}"
                               FontSize="15"
                               IsVisible="{Binding $parent[UserControl].DataContext.IsMenuTextVisible}"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>

              <ListBox.ItemContainerTheme>
                <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                  <Setter Property="Padding" Value="6,10" />
                  <Setter Property="Margin" Value="8,2" />
                  <Setter Property="CornerRadius" Value="8" />
                </ControlTheme>
              </ListBox.ItemContainerTheme>
            </ListBox>
          </ScrollViewer>
        </DockPanel>
      </DrawerPage.Drawer>

      <NavigationPage x:Name="MainNavigation"
                      IsBackButtonVisible="True"
                      IsGestureEnabled="True"
                      HasShadow="True" />
    </DrawerPage>
	</dialogHostAvalonia:DialogHost>
</UserControl>
