<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageType>Template</PackageType>
    <PackageId>CrossWeb.Templates</PackageId>
    <PackageVersion>0.1.0</PackageVersion>
    <Title>CrossWeb 项目模板</Title>
    <Authors>CrossWeb contributors</Authors>
    <Description>包含 Avalonia、React、TypeScript 与 PicoServer 的跨平台 Web 融合项目模板。</Description>
    <PackageTags>dotnet-new;templates;avalonia;react;typescript;picoserver</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5107;NU5110;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None
      Include="..\.template-content\README.md"
      Pack="true"
      PackagePath="\" />
    <Content
      Include="..\**\*"
      Exclude="
        ..\.git\**;
        ..\.vs\**;
        ..\**\.vs\**;
        ..\**\bin\**;
        ..\**\obj\**;
        ..\**\node_modules\**;
        ..\**\dist\**;
        ..\**\artifacts\**;
        ..\**\Assets\Web\**;
        ..\**\Logs\**;
        ..\**\*.log;
        ..\**\*.nupkg;
        ..\docs\**;
        ..\template-pack\**;
        ..\安装模板.bat;
        ..\README.md;
        ..\feature_list.json;
        ..\progress.md;
        ..\session-handoff.md"
      Pack="true"
      PackagePath="content" />
  </ItemGroup>
</Project>
